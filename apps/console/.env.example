NEXT_PUBLIC_LCP_CONTRACT_ID=your-contract.testnet
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional same-network fallbacks; the Console also supplies public defaults.
NEXT_PUBLIC_NEAR_RPC_FALLBACK_URLS=https://near-testnet.drpc.org,https://testnet-rpc.intea.rs
# Testnet preview history service; production uses https://indexer.lcp.gama.works.
NEXT_PUBLIC_LCP_EVENT_INDEXER_URL=https://lcp-event-indexer.wasabinetwork.workers.dev
# Leave blank until the private reviewer-access Worker has been provisioned and deployed.
NEXT_PUBLIC_LCP_REVIEWER_ACCESS_URL=
NEXT_PUBLIC_LCP_REVIEWER_ACCESS_RECIPIENT=lcp.gama.works/reviewer-access
