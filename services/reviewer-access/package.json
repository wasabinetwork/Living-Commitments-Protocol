{
  "name": "@lcp/reviewer-access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --strict-vars false",
    "build:test": "tsc --project tsconfig.test.json",
    "check": "tsc --noEmit -p tsconfig.json && wrangler deploy --dry-run --config wrangler.jsonc",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}
