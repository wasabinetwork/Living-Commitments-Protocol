{
  "$schema": "https://unpkg.com/wrangler@4.161.0/config-schema.json",
  "name": "lcp-event-indexer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "indexer-preview.lcp.gama.works",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "limits": {
    "cpu_ms": 30000,
    "subrequests": 1000
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lcp-event-indexer",
      "database_id": "6725b913-4c7d-4f47-b79a-7bb8f82bf3ee",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NETWORK": "testnet",
    "CONTRACT_ID": "livingcommitmentsprotocol.testnet",
    "SOURCE_BASE_URL": "https://testnet.neardata.xyz",
    "START_BLOCK_HEIGHT": "276808247",
    "MAX_BLOCKS_PER_RUN": "40",
    "MAX_BLOCK_BYTES": "16777216",
    "SOURCE_REQUEST_INTERVAL_MS": "1000",
    "ALLOWED_ORIGINS": "https://preview.lcp-preview.pages.dev"
  }
}
