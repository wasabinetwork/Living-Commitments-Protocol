{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "living-commitments-protocol",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/console/out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
